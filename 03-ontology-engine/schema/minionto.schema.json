    "Condition": {
      "additionalProperties": false,
      "description": "조건식. 아래 형식 중 정확히 하나를 쓴다.\n\n- 비교:       {field: customer.risk_level, op: eq, value: 높음}\n- 논리:       {all: [...]}, {any: [...]}, {not: {...}}\n- 링크 수량:  {some: {link: tasks, where: {...}}}, {none: {...}}\n- 함수:       {function: has_capacity, args: {...}}   (참이면 통과)\n\nfield 는 대상 객체 기준 경로(속성 또는 링크.속성)이거나 $actor.* / $params.* 참조다.\nvalue 가 $ 로 시작하면 참조($params.x, $actor.id, $target.x, $now, $today)로 해석한다.",
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "op": {
          "anyOf": [
            {
              "enum": [
                "eq",
                "ne",
                "in",
                "not_in",
                "gt",
                "gte",
                "lt",
                "lte",
                "is_null",
                "not_null"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "all": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "All"
        },
        "any": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Any"
        },
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "some": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkQuantifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "none": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkQuantifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function"
        },
        "args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Args"
        }
      },
      "title": "Condition",
      "type": "object"
    },
