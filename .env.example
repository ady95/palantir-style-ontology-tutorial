# LLM (OpenAI 호환 API)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# 임베딩 API
EMBED_BASE_URL=http://localhost:8000
EMBED_SERVER_MODEL=bge-m3

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=onto
POSTGRES_PASSWORD=onto
POSTGRES_DB=ontology
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://onto:onto@localhost:5434/ontology
NORTHWIND_DATABASE_URL=postgresql+psycopg://onto:onto@localhost:5434/northwind
TAXOS_DATABASE_URL=postgresql+psycopg://onto:onto@localhost:5434/taxos

# MiniOnto API 토큰 서명 키 (21장) — 32바이트 이상 임의 문자열. 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MINIONTO_TOKEN_SECRET=
