@prefix tx:   <https://example.org/taxos#> .
@prefix txs:  <https://example.org/taxos/shapes#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
#  SHACL 데이터 제약 (닫힌 세계식 검증)
#  OWL 공리는 "무엇이 참인지"를 추론하고, SHACL은 "데이터가 규칙을 지키는지"를 검사한다.
# =====================================================================

txs:CustomerShape a sh:NodeShape ;
    sh:targetClass tx:Customer ;
    sh:property [
        sh:path tx:businessRegNo ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^999-[0-9]{2}-[0-9]{5}$" ;
        sh:message "사업자등록번호가 없거나 형식이 맞지 않습니다." ] ;
    sh:property [
        sh:path tx:riskLevel ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "낮음" "보통" "높음" ) ;
        sh:message "위험 등급은 낮음·보통·높음 중 하나여야 합니다." ] ;
    sh:property [
        sh:path tx:businessStatus ; sh:minCount 1 ;
        sh:in ( "영업" "휴업" "폐업" ) ] ;
    sh:property [
        sh:path tx:managedBy ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class tx:Accountant ;
        sh:message "고객에게는 담당자가 정확히 한 명 있어야 합니다." ] .

txs:CorporationShape a sh:NodeShape ;
    sh:targetClass tx:Corporation ;
    sh:not [ sh:class tx:SimplifiedTaxpayer ] ;
    sh:message "법인은 간이과세자가 될 수 없습니다." .

txs:TaxReturnShape a sh:NodeShape ;
    sh:targetClass tx:TaxReturn ;
    sh:property [ sh:path tx:dueDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [
        sh:path tx:returnStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "자료수집중" "검토중" "신고완료" "기한후신고" ) ] .

txs:DocumentSubmissionShape a sh:NodeShape ;
    sh:targetClass tx:DocumentSubmission ;
    sh:property [ sh:path tx:documentType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class tx:DocumentType ] ;
    sh:property [
        sh:path tx:submissionStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "미요청" "요청됨" "제출완료" "해당없음" ) ] ;
    sh:sparql [
        sh:message "제출완료 상태인데 제출일(tx:submittedAt)이 없습니다." ;
        sh:select """
            SELECT $this WHERE {
              $this <https://example.org/taxos#submissionStatus> "제출완료" .
              FILTER NOT EXISTS { $this <https://example.org/taxos#submittedAt> ?d }
            }""" ] .

# 현재 신고인데 자료 제출 현황이 하나도 등록되지 않은 경우 → 오류가 아니라 '확인 필요' 경고
txs:CurrentReturnCompletenessShape a sh:NodeShape ;
    sh:targetClass tx:TaxReturn ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "자료 제출 현황이 등록되지 않은 현재 신고입니다. 미제출로 단정하지 말고 확인이 필요합니다." ;
        sh:select """
            SELECT $this WHERE {
              $this <https://example.org/taxos#dueDate> "2027-01-25"^^<http://www.w3.org/2001/XMLSchema#date> .
              FILTER NOT EXISTS { $this <https://example.org/taxos#hasSubmission> ?s }
            }""" ] .
